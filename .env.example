# Copy to .env.local and fill in. Never commit real values.
# Supabase project URL + anon key (public; the client bundle receives these).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER prefix with NEXT_PUBLIC_ and never ship to the client.
# Used only for admin operations that must bypass Row Level Security
# (invite flow, hard deletes). PostgreSQL RLS is the authorization layer.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — invite emails + weekly overdue-activity digest (server only).
RESEND_API_KEY=
DEALFLOW_FROM_EMAIL="Dealflow <noreply@example.com>"

# Bearer token protecting the /api/cron/* routes (server only).
CRON_SECRET=

# App URL used to build absolute links in emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000
